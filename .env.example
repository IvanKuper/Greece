PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DATABASE_PATH=./storage/greece.db

# Required only when creating a brand-new database. Never commit the real value.
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters

# Public URL used in password-reset emails (for example, https://app.example.com).
PUBLIC_APP_URL=http://localhost:3000

# Optional Resend email service. When set, Resend is used instead of SMTP.
RESEND_API_KEY=replace-with-your-resend-api-key

# Gmail: use smtp.gmail.com, port 587, secure false, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=greece.maintenance.servicese.ltd@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=GREECE Website <greece.maintenance.servicese.ltd@gmail.com>
CONTACT_EMAIL=greece.maintenance.servicese.ltd@gmail.com
