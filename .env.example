PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DATABASE_PATH=./storage/greece.db

# Gmail: use smtp.gmail.com, port 465, secure true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=greece.maintenance.servicese.ltd@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=GREECE Website <greece.maintenance.servicese.ltd@gmail.com>
CONTACT_EMAIL=greece.maintenance.servicese.ltd@gmail.com

# Optional. Runtime secrets are generated securely in storage when omitted.
JWT_SECRET=
JWT_REFRESH_SECRET=
BACKUP_ENCRYPTION_KEY=

# Optional OpenTelemetry collector (Grafana, Honeycomb, Datadog, etc.).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gris-business-platform
