    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "public/crm.js", "public/contact-fix.js", "public/site-fixes.js", "server.js"],
  "exclude": ["node_modules", "public/assets/**", "storage/**"]
}
